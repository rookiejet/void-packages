# Template file for 'himalaya'
pkgname=himalaya
version=2.2.1
revision=1
build_style=cargo
build_helper="qemu"
hostmakedepends="pkg-config libgit2-1.9-devel"
makedepends="libgit2-1.9-devel sqlite-devel"
short_desc="CLI email client"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT OR Apache-2.0"
homepage="https://pimalaya.org"
changelog="https://raw.githubusercontent.com/pimalaya/himalaya/master/CHANGELOG.md"
distfiles="https://github.com/pimalaya/himalaya/archive/refs/tags/v${version}.tar.gz"
checksum=261b6d3bce4f0de6399b347525fc3c687f309d83840b4e10a58ab7ad70c03544

post_install() {
	vlicense LICENSE-MIT
	vlicense LICENSE-APACHE
	vdoc README.md
	vdoc MIGRATION.md

	local himalaya="${DESTDIR}/usr/bin/himalaya"
	vtargetrun ${himalaya} manual --dir .
	local page sub esub
	for page in himalaya-*.1; do
		sub=${page#himalaya-}
		sub=${sub%.1}
		# manual renders subcommand pages under their bare name; prefix
		# it with the program name (raw in .TH, roff-escaped '\-' in text)
		esub=$(printf '%s' "$sub" | sed 's|-|\\\\-|g')
		vsed -i 's|^[.]TH '"${sub}"' .*|.TH himalaya-'"${sub}"' 1  "himalaya '"${version}"'"|' ${page}
		vsed -i 's|^'"${esub}"' \\- |himalaya\\-'"${esub}"' \\- |' ${page}
		vsed -i 's|\\fB'"${esub}"'\\fR|\\fBhimalaya '"${esub}"'\\fR|' ${page}
		if grep -q '^.SH SUBCOMMANDS' ${page}; then
			vsed -i 's|^'"${esub}"'\\-|himalaya\\-'"${esub}"'\\-|' ${page}
		fi
		vman ${page}
	done
	vman himalaya.1

	vtargetrun ${himalaya} completion bash fish zsh --dir .
	vcompletion himalaya.bash bash
	vcompletion himalaya.fish fish
	vcompletion _himalaya zsh

	vsconf config.sample.toml config.toml
}
