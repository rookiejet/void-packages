# Template file for 'python3-deadlib'
pkgname=python3-deadlib
version=3.13.0
revision=1
build_style=python3-pep517
build_helper="rust"
metapackage=yes
hostmakedepends="cargo maturin python3-build python3-installer python3-setuptools"
makedepends="libxcrypt-devel python3-devel rust-std"
short_desc="Redistribution of Python's removed standard-library modules"
maintainer="yosh <yosh-git@riseup.net>"
license="Python-2.0, LGPL-2.1-only"
homepage="https://github.com/youknowone/python-deadlib"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=bde43692d5a1de2a33777ff99f4c4344f7cca3a49362b2484a13870706194613
# Packages have separate test suites and no common test runner.
make_check=no

# distutils is not included: upstream declares it incompatible with Python 3.13.
subpackages="python3-aifc python3-asynchat python3-asyncore python3-cgi
 python3-cgitb python3-chunk python3-crypt python3-deprecated-crypt-alternative
 python3-imghdr python3-mailcap python3-nntplib python3-pipes python3-smtpd
 python3-sndhdr python3-sunau python3-telnetlib python3-uu python3-xdrlib"
depends="${subpackages}"

_build_module() {
	local module="$1"
	(
		cd "${module}"
		python3 -m build --no-isolation --wheel
	)
}

do_build() {
	local module
	for module in aifc asynchat asyncore cgi cgitb chunk crypt imghdr mailcap nntplib pipes smtpd sndhdr sunau telnetlib uu xdrlib; do
		_build_module "${module}"
	done

	(
		cd _crypt
		maturin build -i /usr/bin/python3 -o dist --release --target "${RUST_TARGET}" --manylinux off
		# Cross builds need a target-independent tag: the host Python determines
		# maturin's tag, although the extension was built for ${RUST_TARGET}.
		if [ -n "${CROSS_BUILD}" ]; then
			mv dist/deprecated_crypt_alternative-*.whl \
				dist/deprecated_crypt_alternative-${version}-py3-none-any.whl
		fi
	)
}

do_install() {
	local module
	for module in aifc asynchat asyncore cgi cgitb chunk crypt imghdr mailcap nntplib pipes smtpd sndhdr sunau telnetlib uu xdrlib; do
		python3 -m installer --destdir "${DESTDIR}" --no-compile-bytecode \
			"${module}"/dist/*.whl
	done
	python3 -m installer --destdir "${DESTDIR}" --no-compile-bytecode _crypt/dist/*.whl

	vlicense aifc/LICENSE
}


python3-aifc_package() {
	short_desc+=" - AIFF and AIFF-C audio files support"
	depends="python3-chunk"
	pkg_install() {
		vmove "${py3_sitelib}/aifc"
	}
}

