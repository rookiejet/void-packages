post_extract() {
	vsrcextract -C subprojects/ixwebsocket ${_ixwebsocket_commit}.tar.gz
	vsrcextract -C subprojects/keychain ${_keychain_commit}.tar.gz
	vsrcextract -C subprojects/miniaudio ${_miniaudio_commit}.tar.gz
	vsrcextract -C subprojects/mlspp ${_mlspp_commit}.tar.gz
	vsrcextract -C subprojects/qrcodegen ${_qrcodegen_commit}.tar.gz
	vsrcextract -C subprojects/libdave ${_dave_commit}.tar.gz
}

do_install() {
	vmkdir usr/bin
	vmkdir usr/share/abaddon
	vcopy build/abaddon usr/bin
	vcopy res/css usr/share/abaddon
	vcopy res/res usr/share/abaddon

	vdoc README.md

	vinstall res/desktop/io.github.uowuo.abaddon.desktop 644 \
	 usr/share/applications
	vinstall res/desktop/io.github.uowuo.abaddon.metainfo.xml 644 \
	 usr/share/metainfo
	vinstall res/desktop/icon.svg 644 usr/share/icons/hicolor/scalable/apps \
	 io.github.uowuo.abaddon.svg
}
