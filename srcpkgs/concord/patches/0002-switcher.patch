+    /// Build a switcher row for a recently selected channel the base list does
+    /// not carry, e.g. a forum post. Search text includes the parent so a post
+    /// is findable by the forum it lives in as well as by its own name.
+    fn recent_channel_switcher_item(
+        &self,
+        channel_id: Id<ChannelMarker>,
+    ) -> Option<ChannelSwitcherItem> {
+        let channel = self.discord.cache.channel(channel_id)?;
+        if channel.is_category() {
+            return None;
+        }
+        let guild_id = channel.guild_id;
+        let guild_name = guild_id.and_then(|guild_id| self.guild_name(guild_id));
+        let group_label = guild_name.unwrap_or("Direct Messages");
+        let search_text = match channel
+            .parent_id
+            .and_then(|parent_id| self.discord.cache.channel(parent_id))
+        {
+            Some(parent) => format!("{group_label} / {} / {}", parent.name, channel.name),
+            None => format!("{group_label} / {}", channel.name),
+        };
+        let unread = self.sidebar_channel_unread(channel_id);
+        Some(ChannelSwitcherItem::Channel {
+            channel_id,
+            guild_name: guild_name.map(str::to_owned),
+            display: ChannelSwitcherDisplay {
+                group_label: group_label.to_owned(),
+                parent_label: guild_name.map(str::to_owned),
+                label: channel_switcher_channel_label(channel),
+                unread,
+                badge_state: channel_switcher_badge_state(
+                    guild_id,
+                    unread,
+                    self.channel_unread_message_count(channel_id),
+                ),
+                search_text,
+                depth: 0,
+                group_order: 0,
+                original_index: 0,
+            },
+        })
+    }
+
     fn push_direct_message_switcher_items(&self, items: &mut Vec<ChannelSwitcherItem>) {
         let mut channels = self.discord.cache.channels_for_guild(None);
         channels.retain(|channel| !channel.is_category() && !channel.is_thread());
