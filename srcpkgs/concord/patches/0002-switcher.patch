+#[test]
+fn channel_switcher_lists_recently_opened_forum_post() {
+    let guild_id = Id::new(1);
+    let general_id = Id::new(11);
+    let forum_id = Id::new(20);
+    let post_id = Id::new(31);
+    let mut state = DashboardState::new();
+    state.push_event(guild_create_event(
+        guild_id,
+        "guild",
+        vec![
+            category_channel_info(guild_id, Id::new(10), "Text Channels", 0),
+            child_text_channel_info(guild_id, general_id, Id::new(10), "general", 0),
+            ChannelInfo {
+                guild_id: Some(guild_id),
+                position: Some(1),
+                name: "announcements".to_owned(),
+                ..ChannelInfo::test(forum_id, "forum")
+            },
+        ],
+    ));
+    state.confirm_selected_guild();
+    state.push_event(AppEvent::ThreadUpsert {
+        thread: ThreadGatewayInfo {
+            channel: thread_channel_info(guild_id, forum_id, post_id, "a post"),
+            current_user_member: None,
+        },
+        created: true,
+    });
+
+    state.open_channel_switcher();
+    assert!(
+        channel_switcher_items(&state)
+            .iter()
+            .all(|item| item.channel_id() != Some(post_id)),
+        "an unvisited forum post stays out of the switcher"
+    );
+    state.close_channel_switcher();
+
+    state.activate_channel(post_id);
+    state.activate_channel(general_id);
+    state.open_channel_switcher();
+
+    let post = channel_switcher_items(&state)
+        .into_iter()
+        .find(|item| item.channel_id() == Some(post_id))
+        .expect("a recently opened forum post should be listed");
+    let display = post.display();
+    assert_eq!(display.group_label, "Recent Channels");
+    assert_eq!(display.label, "🧵 a post");
+    assert_eq!(display.parent_label.as_deref(), Some("guild"));
+    assert_eq!(display.search_text, "guild / announcements / a post");
+
+    for ch in "announce".chars() {
+        state.push_channel_switcher_char(ch);
+    }
+    let filtered: Vec<Id<ChannelMarker>> = channel_switcher_items(&state)
+        .into_iter()
+        .filter_map(|item| item.channel_id())
+        .collect();
+    assert!(
+        filtered.contains(&post_id),
+        "the post's forum name should match"
+    );
+}
