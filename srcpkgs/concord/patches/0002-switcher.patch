+#[test]
+fn channel_switcher_recent_channels_restore_from_saved_ui_state() {
+    use crate::config::{ComposerOptions, CredentialOptions, KeymapOptions};
+
+    let mut source = state_with_channel_tree();
+    source.activate_channel(Id::new(12));
+    source.activate_channel(Id::new(11));
+    let saved = source
+        .take_ui_state_save_request()
+        .expect("opening a channel should mark ui state dirty");
+    assert_eq!(saved.recent_channel_ids, vec![Id::new(11), Id::new(12)]);
+
+    let mut state = DashboardState::new_with_options(
+        DisplayOptions::default(),
+        ComposerOptions::default(),
+        CredentialOptions::default(),
+        NotificationOptions::default(),
+        VoiceOptions::default(),
+        KeymapOptions::default(),
+        saved,
+    );
+    state.push_event(guild_create_event(
+        Id::new(1),
+        "guild",
+        vec![
+            category_channel_info(Id::new(1), Id::new(10), "Text Channels", 0),
+            child_text_channel_info(Id::new(1), Id::new(11), Id::new(10), "general", 0),
+            child_text_channel_info(Id::new(1), Id::new(12), Id::new(10), "random", 1),
+        ],
+    ));
+    state.confirm_selected_guild();
+
+    state.open_channel_switcher();
+    let recent: Vec<Id<ChannelMarker>> = channel_switcher_items(&state)
+        .into_iter()
+        .filter(|item| item.display().group_label == "Recent Channels")
+        .filter_map(|item| item.channel_id())
+        .collect();
+    assert_eq!(recent, vec![Id::new(11), Id::new(12)]);
+}
