+#[test]
+fn disabled_typing_indicator_suppresses_composer_typing() {
+    use std::time::{Duration, Instant};
+
+    let mut state = state_with_writable_channel();
+    state.start_composer();
+    state.options.composer_options.send_typing_indicator = false;
+
+    let start = Instant::now();
+    assert_eq!(state.note_composer_typing_at(start), None);
+    assert_eq!(
+        state.note_composer_typing_at(start + Duration::from_secs(8)),
+        None
+    );
+
+    state.options.composer_options.send_typing_indicator = true;
+    assert_eq!(
+        state.note_composer_typing_at(start + Duration::from_secs(16)),
+        Some(AppCommand::TriggerTyping {
+            channel_id: Id::new(2),
+        })
+    );
+}
